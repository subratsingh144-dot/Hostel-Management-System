<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>HostelMS | Payments</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Segoe UI", sans-serif;
  background: #0f172a;
  color: #fff;
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* MOBILE BUTTON */
.mobile-toggle {
  display: none;
  position: fixed;
  top: 15px;
  left: 15px;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-size: 20px;
  cursor: pointer;
  z-index: 1100;
}

/* SIDEBAR */
.sidebar {
  width: 240px;
  background: #020617;
  padding: 20px;
  display: flex;
  flex-direction: column;
  transition: 0.3s;
}

.menu-item {
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 10px;
  cursor: pointer;
  color: #94a3b8;
  text-decoration: none;
  display: block;
}

.menu-item:hover {
  background: rgba(255,255,255,0.1);
  color: #fff;
}

.menu-item.active {
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  color: #fff;
}

/* MAIN */
.main {
  flex: 1;
  padding: 40px;
  overflow-y: auto;
}

/* PAYMENT CARD */
.payment-card {
  background: linear-gradient(135deg, #312e81, #4c1d95);
  padding: 25px;
  border-radius: 16px;
  margin-bottom: 25px;
}

.payment-card h1 {
  font-size: 40px;
  margin: 10px 0;
}

.payment-buttons {
  margin-top: 15px;
  display: flex;
  gap: 15px;
}

.btn {
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  border: none;
  font-weight: 600;
}

.btn-pay {
  background: #22c55e;
  color: white;
}

.btn-pay:hover {
  background: #16a34a;
}

.btn-cash {
  background: transparent;
  border: 1px solid #94a3b8;
  color: #fff;
}

/* TABLE */
.table-box {
  background: #1e293b;
  padding: 20px;
  border-radius: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px;
  text-align: left;
}

th {
  color: #94a3b8;
  border-bottom: 1px solid #334155;
}

tr:not(:last-child) {
  border-bottom: 1px solid #334155;
}

/* STATUS */
.status {
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 12px;
  display: inline-block;
}

.paid {
  background: rgba(34,197,94,0.2);
  color: #22c55e;
}

.late {
  background: rgba(234,179,8,0.2);
  color: #eab308;
}
.pending {
  background: rgba(239,68,68,0.2);
  color: #ef4444;
}

.late-fee {
  color: #eab308;
}

.no-fee {
  color: #999;
}

/* RESPONSIVE */
@media(max-width:768px){
  .mobile-toggle { display:block; }
  .sidebar {
    position: fixed;
    left: -240px;
    top: 0;
    height: 100%;
  }
  .sidebar.open { left: 0; }
}
</style>
</head>

<body>

<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
  <h2 style="margin-bottom:20px;">🏠 HostelMS</h2>

  <a href="/user/userDashboard" class="menu-item">My Room</a>
  <a href="/user/payments" class="menu-item active">Payments</a>
  <a href="/user/complaints" class="menu-item">Complaints</a>
  <a href="/user/notices" class="menu-item">Notices</a>

  <div style="margin-top:auto;">
    <button class="btn" style="width:100%; background:#ef4444; color: white;">🚪 Sign Out</button>
  </div>
</div>

<!-- MAIN -->
<div class="main">

  <h2>Payments</h2>
  <p style="color:#94a3b8; margin-bottom:20px;">Your payment history</p>

  <!-- CARD -->
  <div class="payment-card">
    <small>DUE THIS MONTH</small>
    
    <h1>
  ₹<%= card.status === 'paid' ? '0.0' : (card.amount ?? '0.0') %>
</h1>
    <p style="color:#cbd5f5;">

<%
  let dueDate = '---';
  if (card && card.due_date) {
    dueDate = new Date(card.due_date).toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  }
%>

<p style="color:#cbd5f5;">
  Due on <%= dueDate %> · Late fee after 5th
</p>


    <div class="payment-buttons">
    <% if(card && card.id) { %>
  <button class="btn btn-pay" onclick="payNow(<%= card.id %>)">
    Pay Online
  </button>
<% } else { %>
  <button class="btn btn-pay" disabled>
    No Payment Due
  </button>
<% } %>
      <button class="btn btn-cash">I've Paid (Cash)</button>
    </div>
  </div>

  <!-- TABLE -->
  <div class="table-box">
    <table>
      <thead>
        <tr>
          <th>Amount</th>
          <th>Late Fee</th>
          <th>Total</th>
          <th>Date</th>
          <th>Status</th>
        </tr>
      </thead>
    <tbody>
  <% histories.forEach(history => { %>
    <tr>
      <td>₹<%= history.amount %></td>

      
<td class="<%= Number(history.late_fee) > 0 ? 'late-fee' : 'no-fee' %>">
  <%= Number(history.late_fee) > 0 ? '₹' + history.late_fee : '-' %>
</td>
      <td>₹<%= history.total %></td>

      <td>
        <%= new Date(history.date).toISOString().split('T')[0] %>
      </td>

      <td>
        <% if(history.status === 'paid') { %>
          <span class="status paid">Paid</span>

        <% } else if(history.late_fee > 0) { %>
          <span class="status late">Paid Late</span>

        <% } else { %>
          <span class="status pending">Pending</span>
        <% } %>
      </td>
    </tr>
  <% }) %>
</tbody>
    </table>
  </div>

</div>

<script>
function toggleSidebar(){
  document.getElementById("sidebar").classList.toggle("open");
}



</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

async function payNow(paymentId) {

    try {

        const response = await fetch("/payment/create-order", {
    method: "POST",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({ payment_id: paymentId })
});

const text = await response.text();
console.log("RAW RESPONSE:", text);

const data = JSON.parse(text);



      

        const options = {

            key: data.key,

            amount: data.order.amount,

            currency: data.order.currency,

            name: "HostelMS",

            description: "Hostel Fee Payment",

            order_id: data.order.id,

            handler: async function (response) {

                const verifyResponse = await fetch(
                    "/payment/verify-payment",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({

                            ...response,

                            payment_id: paymentId,

                            payment_method:
                                response.method || "upi"
                        })
                    }
                );

                const verifyData =
                    await verifyResponse.json();

                if (verifyData.success) {

                    alert("Payment Successful");

                    location.reload();

                } else {

                    alert("Payment Failed");
                }
            },

            theme: {
                color: "#6366f1"
            }
        };

        const rzp = new Razorpay(options);

        rzp.open();

    } catch (error) {

        console.log(error);

        alert("Something went wrong");
    }
}

</script>

</body>
</html>