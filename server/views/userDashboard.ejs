<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" sizes="64x64" href="/hostel-logo.png">
    <title>HostelMS | User Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      /* RESET */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", sans-serif;
        background: #0f172a;
        color: #fff;
        display: flex;
        height: 100vh; /* Fixed height to allow inner scroll */
        overflow: hidden; /* Prevents outer body scroll */
      }

      /* MOBILE TOGGLE BUTTON */
      .mobile-toggle {
        display: none;
        position: fixed;
        top: 15px;
        left: 15px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 20px;
        cursor: pointer;
        z-index: 1100;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }

      /* SIDEBAR */
      .sidebar {
        width: 240px;
        height: 100vh;
        background: #020617;
        padding: 20px;
        display: flex;
        flex-direction: column;
        transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0; /* Prevents sidebar from squishing */
        z-index: 1200;
      }

      .close-btn {
        display: none;
        text-align: right;
        font-size: 24px;
        cursor: pointer;
        color: #94a3b8;
        margin-bottom: 10px;
      }

      .logo {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 30px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .menu-item {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: 0.3s;
        color: #94a3b8;
        text-decoration: none;
        display: block;
      }

      .menu-item:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        transform: translateX(5px);
      }

      .menu-item.active {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: #fff;
      }

      /* MAIN CONTENT */
      .main {
        flex: 1;
        padding: 40px; /* Increased padding since topbar is gone */
        overflow-y: auto; /* Only main content scrolls */
        min-width: 0;
      }

      .logout {
        background: #ef4444;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
      }

      .logout:hover {
        background: #dc2626;
        transform: scale(1.02);
      }

      /* PROFILE CARD */
      .profile-card {
        background: linear-gradient(135deg, #312e81, #4c1d95);
        border-radius: 16px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 20px;
        animation: fadeUp 0.8s ease;
      }

      .avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 24px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      /* INFO CARDS */
      .info-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 25px;
      }

      .card {
        background: linear-gradient(135deg, #1e293b, #334155);
        padding: 25px;
        border-radius: 16px;
        text-align: center;
        transition: 0.3s;
        animation: fadeUp 0.8s ease;
      }

      .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      }

      .card span {
        display: block;
        font-size: 32px;
        margin-top: 10px;
        font-weight: bold;
        color: #6366f1;
      }

      /* NOTICE & ANNOUNCEMENTS */
      .notice, .announcement {
        background: #1e293b;
        margin-top: 25px;
        padding: 20px;
        border-radius: 12px;
        animation: fadeUp 1s ease;
      }

      .announcement {
        margin-top: 15px;
        border-left: 4px solid #6366f1;
      }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* RESPONSIVE DESIGN */
      @media (max-width: 768px) {
        .mobile-toggle { display: block; }

        .sidebar {
          position: fixed;
          left: -240px;
          top: 0;
          z-index: 2000;
          height: 100vh;
          box-shadow: 10px 0 30px rgba(0,0,0,0.5);
        }

        .sidebar.open { left: 0; }
        .close-btn { display: block; }

        .main { 
          padding: 80px 20px 20px 20px; 
          height: 100vh;
        }
        
        .profile-card { flex-direction: column; text-align: center; }
      }
    </style>
  </head>

  <body>
    <button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

    <!-- Sidebar remains the only place for logout -->
    <div class="sidebar" id="sidebar">
      <div class="close-btn" onclick="toggleSidebar()">✕</div>
      <div class="logo">🏠 HostelMS</div>

      <nav>
        <a href="/user/userDashboard" class="menu-item active">My Room</a>
        <a href="/user/payments" class="menu-item">Payments</a>
        <a href="/user/complaints" class="menu-item">Complaints</a>
        <a href="/user/notices" class="menu-item">Notices</a>
      </nav>

      <div style="margin-top: auto">
        <form action="/logout" method="GET">
          <button type="submit" class="logout" style="width: 100%">🚪 Sign Out</button>
        </form>
      </div>
    </div>

    <div class="main">
      <!-- TOP BAR LOGOUT REMOVED FROM HERE -->

      <div class="profile-card">
        <div class="avatar">
          <%= user.username ? user.username.split(" ").map(n => n[0]).join("").toUpperCase() : 'U' %>
        </div>
        <div>
          <h2 id="username"><%= user.username || 'Guest User' %></h2>
          <p id="email" style="color: #94a3b8;"><%= user.email || 'No email provided' %></p>
        </div>
      </div>

      <div class="info-cards">
        <div class="card">
          🏢 Floor
          <span> <%= user.floor_number ?? '---' %></span>
        </div>

        <div class="card">
          🚪 Room No
          <span><%= user.room_number || '---' %></span>
        </div>

        <div class="card">
          🛏️ Bed No
          <span><%= user.bed_no ?? '---' %></span>
        </div>
      </div>

      <div class="notice">
        <h3 style="color: #6366f1; margin-bottom: 10px;">📢 Latest Notice</h3>
        

          <% notices.forEach(n => { %>
        
          <div class="announcement">
          <p><%= n.message ?? '---' %></p>
        </div>
       <% }) %>
      </div>

      <div class="announcements" style="margin-top: 30px;">
        <h3 style="margin-bottom: 15px;">Recent Announcements</h3>
        <% broadcasts.forEach(b => { %>
        
          <div class="announcement">
            <strong><%= b.title ?? '---' %></strong><br />
            <%= new Date(b.created_at).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long'
      }) ?? '---' %>
        </div>
       <% }) %>
        
      </div>
    </div>

    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");
        sidebar.classList.toggle("open");
      }

      document.querySelectorAll('.menu-item').forEach(item => {
        item.addEventListener('click', () => {
          if (window.innerWidth <= 768) {
            toggleSidebar();
          }
        });
      });
    </script>
  </body>
</html>
