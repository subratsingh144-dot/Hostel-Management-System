<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>HostelMS | Broadcast</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- FIXED CHART JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", sans-serif;
        background: #0b0e14;
        color: #fff;
        display: flex;
        height: 100vh;
        overflow: hidden;
      }

      .mobile-toggle {
        display: none;
        position: fixed;
        top: 15px;
        left: 15px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 20px;
        cursor: pointer;
        z-index: 1300;
      }

      .sidebar {
        width: 240px;
        background: #11141d;
        padding: 20px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #1f2937;
        transition: 0.3s;
      }

      .logo {
        font-size: 20px;
        font-weight: bold;
        color: #6366f1;
      }
      .admin-label {
        font-size: 10px;
        color: #64748b;
      }

      .profile-mini {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 0;
        border-bottom: 1px solid #1f2937;
        margin-bottom: 20px;
      }

      .avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #312e81;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #818cf8;
      }

      .menu-item {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 5px;
        cursor: pointer;
        color: #94a3b8;
        text-decoration: none;
        display: flex;
        gap: 10px;
      }

      .menu-item.active {
        background: #1e293b;
        color: #fff;
        border-left: 3px solid #6366f1;
      }/* LOGOUT */
  .logout-area{
      margin-top:auto;
      padding-top:10px;
      border-top:1px solid #1e293b;
    }

    .logout-btn{
      width:100%;
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding:14px;
      border-radius:12px;
      text-align:left;
      cursor:pointer;
      font-size:15px;
      transition:0.25s;
    }

    .logout-btn:hover{
      background:#182031;
    }

      .main {
        flex: 1;
        padding: 30px;
        overflow-y: auto;
      }

      .header h1 {
        font-size: 24px;
      }
      .header p {
        color: #64748b;
      }

      .card {
        background: #1a1f2b;
        padding: 20px;
        border-radius: 12px;
        margin-top: 20px;
      }

      .label {
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 5px;
        display: block;
      }

      input,
      textarea {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid #1f2937;
        background: #0f172a;
        color: white;
        margin-bottom: 15px;
      }

      button {
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        padding: 12px 20px;
        border: none;
        border-radius: 10px;
        color: #fff;
        cursor: pointer;
      }

      .message-card {
        background: #1a1f2b;
        padding: 18px;
        border-radius: 12px;
        margin-top: 15px;
        border-left: 4px solid #6366f1;
      }

      .message-card p {
        font-size: 13px;
        color: #94a3b8;
        margin-top: 5px;
      }

      .date {
        font-size: 11px;
        color: #64748b;
        margin-top: 5px;
      }


      @media (max-width: 768px) {
        .mobile-toggle {
          display: block;
        }
        .sidebar {
          position: fixed;
          left: -240px;
          top: 0;
          height: 100vh;
        }
        .sidebar.open {
          left: 0;
        }
        .main {
          padding: 80px 20px;
        }
      }
    </style>
  </head>

  <body>
    <button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

    <div class="sidebar" id="sidebar">
      <div class="logo">HostelMS</div>
      <div class="admin-label">ADMIN PANEL</div>

      <div class="profile-mini">
        <div class="avatar-sm">
          <%= admin.username ? admin.username[0].toUpperCase() : 'A' %>
        </div>
        <div>
          <div><%= admin.username %></div>
          <div style="font-size: 11px; color: #64748b"><%= admin.email %></div>
        </div>
      </div>

      <a href="/admin/adminDashboard" class="menu-item"> 📊 Dashboard </a>

      <a href="/admin/users" class="menu-item"> 👥 Students </a>

      <a href="/admin/AllRooms" class="menu-item"> 🏠 Rooms </a>

      <a href="/admin/payments" class="menu-item"> 💰 Payments </a>

      <a href="/admin/complaints" class="menu-item"> 🛠️ Complaints </a>

      <a href="/admin/broadcast" class="menu-item active"> 📢 Broadcast </a>


      <!--  LOGOUT BUTTON -->
  <div class="logout-area">
      <form action="/logout" method="GET">
        <button class="logout-btn">
          🚪 Sign Out
        </button>
      </form>
    </div>
    </div>

    

    <div class="main">

  <!-- Header -->
  <div class="header">
    <h1>Broadcast Messages</h1>
    <p>Send notices and announcements to all residents</p>
  </div>

  <!-- New Broadcast -->
  <div class="card">

    <h3>📢 New Broadcast</h3>

    <form action="/admin/broadcasts" method="POST">

      <label class="label">TITLE</label>

      <input 
        type="text"
        name="title"
        placeholder="e.g. Power Cut Notice"
        required
      />

      <label class="label">MESSAGE</label>

      <textarea
        name="content"
        rows="4"
        placeholder="Type your message here..."
        required
      ></textarea>

      <button type="submit">
        📤 Send To All Residents
      </button>

    </form>

  </div>

  <!-- Sent Messages -->
  <div class="card">

    <h3>📜 Sent Messages</h3>

    <div id="messages">

      <% messages.forEach((message) => { %>

        <div class="message-card">

          <strong>
            📢 <%= message.title %>
          </strong>

          <p>
            <%= message.content %>
          </p>

          <div class="date">
           

             <%= message.date
              ? new Date(message.date).toLocaleDateString()
              : '-'
            %>
          </div>

        </div>

      <% }) %>

    </div>

  </div>

</div>
    </div>

    <script>
      function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("open");
      }

    </script>
  </body>
</html>
