<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HostelMS | Students</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: "Segoe UI", sans-serif;
  background: #0b0e14;
  color: #fff;
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* MOBILE TOGGLE */
.mobile-toggle {
  display: none;
  position: fixed;
  top: 15px;
  left: 15px;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-size: 20px;
  cursor: pointer;
  z-index: 1300;
}

/* SIDEBAR */
.sidebar {
  width: 240px;
  background: #11141d;
  padding: 20px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid #1f2937;
  transition: 0.4s;
}

.close-btn {
  display: none;
  text-align: right;
  font-size: 24px;
  cursor: pointer;
  color: #94a3b8;
  margin-bottom: 10px;
}

.logo { font-size: 20px; font-weight: bold; color: #6366f1; }
.admin-label { font-size: 10px; color: #64748b; }

.profile-mini {
  display: flex;
  gap: 10px;
  padding: 15px 0;
  border-bottom: 1px solid #1f2937;
  margin-bottom: 20px;
}

.avatar-sm {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: #312e81;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #818cf8;
}

.menu-item {
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 5px;
  cursor: pointer;
  color: #94a3b8;
  text-decoration: none;
  display: flex;
  gap: 10px;
}

.menu-item:hover,
.menu-item.active {
  background: #1e293b;
  color: #fff;
}

.menu-item.active {
  border-left: 3px solid #6366f1;
}

  .logout-area{
      margin-top:auto;
      padding-top:10px;
      border-top:1px solid #1e293b;
    }

    .logout-btn{
      width:100%;
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding:14px;
      border-radius:12px;
      text-align:left;
      cursor:pointer;
      font-size:15px;
      transition:0.25s;
    }

    .logout-btn:hover{
      background:#182031;
    }

/* MAIN */
.main {
  flex: 1;
  padding: 30px;
  overflow-y: auto;
}

.header h1 { font-size: 24px; }
.header p { color: #64748b; }

/* CARD */
.card {
  background: #1a1f2b;
  padding: 20px;
  border-radius: 12px;
  margin-top: 25px;
}

/* TOP BAR */
.top-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 10px;
}

.search {
  padding: 10px;
  border-radius: 8px;
  background: #0b0e14;
  border: 1px solid #2d3748;
  color: white;
  width: 250px;
}

.btn {
  background: #6366f1;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  color: white;
  cursor: pointer;
}

/* TABLE */
table {
  width: 100%;
  border-collapse: collapse;
}

th {
  text-align: left;
  color: #64748b;
  font-size: 12px;
  padding-bottom: 15px;
}

td {
  padding: 14px 0;
  border-top: 1px solid #2d3748;
}

.badge {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.paid { background: rgba(16,185,129,0.1); color: #10b981; }
.unpaid { background: rgba(239,68,68,0.1); color: #ef4444; }

.delete-btn{
  background:#ef4444;
  border:none;
  padding:8px 12px;
  border-radius:6px;
  color:white;
  cursor:pointer;
}

.delete-btn:hover{
  background:#dc2626;
}

/* MOBILE */
@media(max-width:768px){
  .mobile-toggle{ display:block; }

  .sidebar{
    position: fixed;
    left: -240px;
    top:0;
    height:100vh;
  }

  .sidebar.open{ left:0; }

  .close-btn{ display:block; }

  .main{ padding:80px 20px; }
}
</style>
</head>

<body>

<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

<div class="sidebar" id="sidebar">
  <div class="close-btn" onclick="toggleSidebar()">✕</div>

  <div>
    <div class="logo">HostelMS</div>
    <div class="admin-label">ADMIN PANEL</div>
  </div>

  <div class="profile-mini">
    <div class="avatar-sm">
      <%= admin.username ? admin.username[0].toUpperCase() : 'A' %>
    </div>
    <div>
      <div><%= admin.username %></div>
      <div style="font-size:11px;color:#64748b;"><%= admin.email %></div>
    </div>
  </div>

  <a href="/admin/adminDashboard" class="menu-item">📊 Dashboard</a>
  <a href="/admin/users" class="menu-item active">👥 Students</a>
  <a href="/admin/AllRooms" class="menu-item">🏠 Rooms</a>
  <a href="/admin/payments" class="menu-item">💰 Payments</a>
  <a href="/admin/complaints" class="menu-item">🛠️ Complaints</a>
  <a href="#" class="menu-item">📢 Broadcast</a>



  <div class="logout-area">

      <form action="/logout" method="GET">

        <button class="logout-btn">
          🚪 Sign Out
        </button>

      </form>
      </div>
</div>

<div class="main">
  <div class="header">
    <h1>Students</h1>
    <p>All registered residents  <%= totalUser %> totals</p>
  </div>

  <div class="card">
    <div class="top-bar">
      <input type="text" class="search" placeholder="Search..." onkeyup="search()">

      <!-- Add users -->
      <form action="/signup">
        <button class="btn" >+ Add Student</button>
      </form>
      
    </div>

   <table id="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Floor</th>
      <th>Room</th>
      <th>Bed</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>
    <% users.forEach(s => { %>
    <tr>
      <td><%= s.username %></td>
      <td><%= s.email %></td>
      <td><%= s.floor %></td>
      <td><%= s.room_number %></td>
      <td><%= s.bed_no %></td>

      <td>
        <form action="/admin/deleteUser/<%= s.id %>" method="POST">
          <button 
            type="submit"
            class="delete-btn"
            onclick="return confirm('Delete this student?')">
            Delete
          </button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
  </div>
</div>

<script>
function toggleSidebar(){
  document.getElementById("sidebar").classList.toggle("open");
}

function search(){
  let val = document.querySelector(".search").value.toLowerCase();
  document.querySelectorAll("#table tbody tr").forEach(row=>{
    row.style.display = row.innerText.toLowerCase().includes(val) ? "" : "none";
  });
}
</script>

</body>
</html>