<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HostelMS | Payments</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:"Segoe UI",sans-serif;
  background:#0b0e14;
  color:#fff;
  display:flex;
  height:100vh;
  overflow:hidden;
}

/* MOBILE */
.mobile-toggle{
  display:none;
  position:fixed;
  top:15px;
  left:15px;
  background:#6366f1;
  color:white;
  border:none;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
  z-index:1300;
}

/* SIDEBAR */
.sidebar{
  width:240px;
  background:#11141d;
  padding:20px;
  display:flex;
  flex-direction:column;
  border-right:1px solid #1f2937;
  transition:0.3s;
}

.close-btn{
  display:none;
  text-align:right;
  font-size:22px;
  cursor:pointer;
  color:#94a3b8;
}

.logo{
  color:#6366f1;
  font-weight:bold;
  font-size:20px;
}

.admin-label{
  font-size:10px;
  color:#64748b;
}

.profile-mini{
  display:flex;
  gap:10px;
  margin:20px 0;
  padding-bottom:15px;
  border-bottom:1px solid #1f2937;
}

.avatar-sm{
  width:40px;
  height:40px;
  background:#312e81;
  border-radius:8px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#818cf8;
}

.menu-item{
  padding:12px;
  border-radius:8px;
  margin-bottom:5px;
  text-decoration:none;
  color:#94a3b8;
  display:flex;
  gap:10px;
}

.menu-item:hover,
.menu-item.active{
  background:#1e293b;
  color:#fff;
}

.menu-item.active{
  border-left:3px solid #6366f1;
}


/* LOGOUT */
  .logout-area{
      margin-top:auto;
      padding-top:10px;
      border-top:1px solid #1e293b;
    }

    .logout-btn{
      width:100%;
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding:14px;
      border-radius:12px;
      text-align:left;
      cursor:pointer;
      font-size:15px;
      transition:0.25s;
    }

    .logout-btn:hover{
      background:#182031;
    }


/* MAIN */
.main{
  flex:1;
  padding:30px;
  overflow-y:auto;
}

.header h1{
  font-size:24px;
}

.header p{
  color:#64748b;
}

/* CARD */
.card{
  background:#1a1f2b;
  padding:20px;
  border-radius:16px;
  margin-top:20px;
}

/* TABLE */
table{
  width:100%;
  border-collapse:collapse;
}

th{
  text-align:left;
  color:#64748b;
  font-size:12px;
  padding-bottom:15px;
}

td{
  padding:14px 0;
  border-top:1px solid #2d3748;
  font-size:14px;
}

.row{
  transition:0.2s;
}

.row:hover{
  background:rgba(255,255,255,0.03);
}

/* USER */
.user{
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:34px;
  height:34px;
  border-radius:50%;
  background:#6366f1;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:13px;
  font-weight:600;
}

/* BADGES */
.badge{
  padding:5px 12px;
  border-radius:20px;
  font-size:12px;
  display:inline-block;
}

.paid{
  background:rgba(16,185,129,0.15);
  color:#10b981;
}

.unpaid{
  background:rgba(239,68,68,0.15);
  color:#ef4444;
}

.late{
  background:rgba(245,158,11,0.15);
  color:#f59e0b;
}

/* MOBILE */
@media(max-width:768px){

  .mobile-toggle{
    display:block;
  }

  .sidebar{
    position:fixed;
    left:-240px;
    top:0;
    height:100vh;
    z-index:1200;
  }

  .sidebar.open{
    left:0;
  }

  .close-btn{
    display:block;
  }

  .main{
    padding:80px 20px;
  }

  table{
    min-width:700px;
  }
}
</style>
</head>

<body>

<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">

  <div class="close-btn" onclick="toggleSidebar()">✕</div>

  <div>
    <div class="logo">HostelMS</div>
    <div class="admin-label">ADMIN PANEL</div>
  </div>

  <div class="profile-mini">
    <div class="avatar-sm">
      <%= admin.username ? admin.username[0].toUpperCase() : 'A' %>
    </div>

    <div>
      <div><%= admin.username %></div>
      <div style="font-size:11px;color:#64748b;">
        <%= admin.email %>
      </div>
    </div>
  </div>

  <a href="/admin/adminDashboard" class="menu-item">
    📊 Dashboard
  </a>

  <a href="/admin/users" class="menu-item">
    👥 Students
  </a>

  <a href="/admin/AllRooms" class="menu-item">
    🏠 Rooms
  </a>

  <a href="/admin/payments" class="menu-item active">
    💰 Payments
  </a>

  <a href="/admin/complaints" class="menu-item">
    🛠️ Complaints
  </a>

  <a href="#" class="menu-item">
    📢 Broadcast
  </a>

   <!--  LOGOUT BUTTON -->
  <div class="logout-area">
      <form action="/logout" method="GET">
        <button class="logout-btn">
          🚪 Sign Out
        </button>
      </form>
    </div>

</div>

<!-- MAIN -->
<div class="main">

  <div class="header">
    <h1>Payments</h1>
    <p>All payment records</p>
  </div>

  <div class="card">

    <table>

      <thead>
        <tr>
          <th>STUDENT</th>
          <th>AMOUNT</th>
          <th>LATE FEE</th>
          <th>TOTAL</th>
          <th>PAID</th>
          <th>METHOD</th>
          <th>DATE</th>
          <th>STATUS</th>
        </tr>
      </thead>

      <tbody>

        <% payments.forEach(p => { %>

        <tr class="row">

          <!-- STUDENT -->
          <td>
            <div class="user">

              <div class="avatar">
                <%= p.username
                  ? p.username.substring(0,2).toUpperCase()
                  : 'U'
                %>
              </div>

              <span>
                <%= p.username || 'Unknown' %>
              </span>

            </div>
          </td>

          <!-- AMOUNT -->
          <td>
            ₹<%= p.amount %>
          </td>

          <!-- LATE FEE -->
          <td>
            <%= p.late_fee > 0
              ? '₹' + p.late_fee
              : '-'
            %>
          </td>

          <!-- TOTAL -->
          <td>
            ₹<%= Number(p.amount) + Number(p.late_fee || 0) %>
          </td>

          <!-- PAID -->
          <td>
            ₹<%= p.paid_amount %>
          </td>

          <!-- METHOD -->
          <td style="text-transform:capitalize;">
            <%= p.payment_method %>
          </td>

          <!-- DATE -->
          <td>
            <%= p.paid_date
              ? new Date(p.paid_date).toLocaleDateString()
              : '-'
            %>
          </td>

          <!-- STATUS -->
          <td>

            <span class="badge
              <%= 
                p.payment_status === 'Paid'
                  ? 'paid'
                  : p.payment_status === 'Paid Late' || p.payment_status === 'Late'
                  ? 'late'
                  : 'unpaid'
              %>">

              <%= p.payment_status %>

            </span>

          </td>

        </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</div>

<script>

function toggleSidebar(){
  document
    .getElementById("sidebar")
    .classList
    .toggle("open");
}

</script>

</body>
</html>