<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HostelMS | Rooms</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body{
  font-family:"Segoe UI",sans-serif;
  background:#0b0e14;
  color:#fff;
  display:flex;
  height:100vh;
  overflow:hidden;
}

/* MOBILE TOGGLE */
.mobile-toggle{
  display:none;
  position:fixed;
  top:15px;
  left:15px;
  background:#6366f1;
  border:none;
  padding:10px 15px;
  border-radius:8px;
  color:white;
  font-size:20px;
  cursor:pointer;
  z-index:1300;
}

/* SIDEBAR */
.sidebar{
  width:240px;
  background:#11141d;
  padding:20px;
  display:flex;
  flex-direction:column;
  border-right:1px solid #1f2937;
  transition:0.3s;
}

.close-btn{
  display:none;
  text-align:right;
  cursor:pointer;
  color:#94a3b8;
  font-size:22px;
}

.logo{ color:#6366f1; font-size:20px; font-weight:bold; }
.admin-label{ font-size:10px; color:#64748b; }

.profile-mini{
  display:flex;
  gap:10px;
  margin:20px 0;
  padding-bottom:15px;
  border-bottom:1px solid #1f2937;
}

.avatar-sm{
  width:40px;height:40px;
  background:#312e81;
  display:flex;align-items:center;justify-content:center;
  border-radius:8px;
  color:#818cf8;
}

.menu-item{
  padding:12px;
  border-radius:8px;
  margin-bottom:5px;
  color:#94a3b8;
  text-decoration:none;
  display:flex;
  gap:10px;
}

.menu-item:hover,
.menu-item.active{
  background:#1e293b;
  color:#fff;
}

.menu-item.active{
  border-left:3px solid #6366f1;
}


  .logout-area{
      margin-top:auto;
      padding-top:10px;
      border-top:1px solid #1e293b;
    }

    .logout-btn{
      width:100%;
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding:14px;
      border-radius:12px;
      text-align:left;
      cursor:pointer;
      font-size:15px;
      transition:0.25s;
    }

    .logout-btn:hover{
      background:#182031;
    }


/* MAIN */
.main{
  flex:1;
  padding:30px;
  overflow-y:auto;
}

.header h1{ font-size:24px; }
.header p{ color:#64748b; }

/* CARD */
.card{
  background:#1a1f2b;
  border-radius:16px;
  padding:20px;
  margin-top:20px;
}

/* LEGEND */
.legend{
  display:flex;
  gap:20px;
  margin-bottom:20px;
}

.legend div{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:13px;
  color:#94a3b8;
}

.dot{
  width:14px;
  height:14px;
  border-radius:4px;
}

.green{ background:#10b981; }
.yellow{ background:#f59e0b; }
.red{ background:#ef4444; }

/* FLOOR */
.floor{
  margin-top:20px;
}

.floor-title{
  font-size:13px;
  color:#64748b;
  margin-bottom:10px;
}

/* ROOMS GRID */
.rooms{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(120px,1fr));
  gap:12px;
}

.room{
  padding:15px;
  border-radius:12px;
  text-align:center;
  border:1px solid #1f2937;
  transition:0.2s;
  cursor:pointer;
}

.room:hover{
  transform:translateY(-2px);
}

/* STATUS COLORS */
.available{
  background:rgba(16,185,129,0.1);
  border-color:#065f46;
}

.partial{
  background:rgba(245,158,11,0.1);
  border-color:#78350f;
}

.full{
  background:rgba(239,68,68,0.1);
  border-color:#7f1d1d;
}

.room-number{
  font-weight:bold;
  margin-bottom:5px;
}

.room small{
  color:#94a3b8;
}

/* MOBILE */
@media(max-width:768px){
  .mobile-toggle{ display:block; }

  .sidebar{
    position:fixed;
    left:-240px;
    top:0;
    height:100vh;
  }

  .sidebar.open{ left:0; }
  .close-btn{ display:block; }
  .main{ padding:80px 20px; }
}
</style>
</head>

<body>

<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>

<div class="sidebar" id="sidebar">
  <div class="close-btn" onclick="toggleSidebar()">✕</div>

  <div>
    <div class="logo">HostelMS</div>
    <div class="admin-label">ADMIN PANEL</div>
  </div>

  <div class="profile-mini">
    <div class="avatar-sm">
      <%= admin.username ? admin.username[0].toUpperCase() : 'A' %>
    </div>
    <div>
      <div><%= admin.username %></div>
      <div style="font-size:11px;color:#64748b;"><%= admin.email %></div>
    </div>
  </div>

  <a href="/admin/adminDashboard" class="menu-item">📊 Dashboard</a>
  <a href="/admin/users" class="menu-item">👥 Students</a>
  <a href="/admin/AllRooms" class="menu-item active">🏠 Rooms</a>
  <a href="/admin/payments" class="menu-item">💰 Payments</a>
  <a href="/admin/complaints" class="menu-item">🛠️ Complaints</a>
  <a href="/admin/broadcast" class="menu-item">📢 Broadcast</a>

  <div class="logout-area">
      <form action="/logout" method="GET">
        <button class="logout-btn">
          🚪 Sign Out
        </button>
      </form>
    </div>
</div>

<div class="main">
  <div class="header">
    <h1>Room Management</h1>
    <p>Floor-wise occupancy overview</p>
  </div>

  <div class="card">

    <div class="legend">
      <div><span class="dot green"></span>Available</div>
      <div><span class="dot yellow"></span>Partially Occupied</div>
      <div><span class="dot red"></span>Full</div>
    </div>

    <!-- FLOOR LOOP -->
    <% floors.forEach(floor => { %>
    <div class="floor">
      <div class="floor-title">FLOOR <%= floor.floor_number %></div>

      <div class="rooms">
        <% floor.rooms.forEach(room => { %>

          <% 
            let cls = "available";
            if(room.available_beds === 0) cls="full";
            else if(room.available_beds < room.total_beds) cls="partial";
          %>

          <div class="room <%= cls %>">
            <div class="room-number"><%= room.room_number %></div>
            <small>
              <%= room.total_beds - room.available_beds %>/<%= room.total_beds %> beds
            </small>
          </div>

        <% }) %>
      </div>
    </div>
    <% }) %>

  </div>
</div>

<script>
function toggleSidebar(){
  document.getElementById("sidebar").classList.toggle("open");
}
</script>

</body>
</html>