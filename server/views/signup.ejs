<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>HostelMS | Sign Up</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      /* RESET & BASE (Matches Dashboard) */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #0f172a; /* Same as Dashboard background */
        color: #fff;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* FORM CONTAINER (Matches Info Cards style) */
      .form-container {
        background: #1e293b; /* Same as Dashboard cards */
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        width: 100%;
        max-width: 400px;
        animation: fadeUp 0.8s ease;
      }

      h2 {
        text-align: center;
        margin-bottom: 25px;
        font-size: 24px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        -webkit-background-clip: text;
        background-clip: text; /* <--- Standard property added here */
        -webkit-text-fill-color: transparent;
      }

      label {
        display: block;
        margin-top: 15px;
        font-size: 14px;
        color: #94a3b8; /* Muted text color */
        font-weight: 500;
      }

      /* INPUTS & SELECTS */
      input,
      select {
        width: 100%;
        padding: 12px;
        margin-top: 6px;
        border-radius: 8px;
        border: 1px solid #334155;
        background: #0f172a;
        color: #fff;
        font-size: 15px;
        transition: 0.3s;
      }

      input:focus,
      select:focus {
        border-color: #6366f1;
        outline: none;
        box-shadow: 0 0 8px rgba(99, 102, 241, 0.3);
      }

      /* BUTTON (Matches Active Menu Item) */
      button {
        width: 100%;
        margin-top: 25px;
        padding: 14px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
      }

      button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4);
      }

      /* ANIMATION (Same as Dashboard) */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Custom Styling for Select options */
      option {
        background: #1e293b;
        color: #fff;
      }
    </style>
  </head>

  <body>
    <div class="form-container">
      <h2>🏠 HostelMS Signup</h2>

      <form action="/api/auth/signup" method="POST">
        <label>Username</label>
        <input type="text" name="username" placeholder="Full Name" required />

        <label>Email Address</label>
        <input
          type="email"
          name="email"
          placeholder="email@hostel.com"
          required
        />

        <label>Password</label>
        <input
          type="password"
          name="password"
          placeholder="••••••••"
          required
        />

        <div style="display: flex; gap: 15px">
          <div style="flex: 1">
            <label>Floor</label>
            <select
              id="floor"
              name="floor_id"
              onchange="updateRooms()"
              required
            >
              <option value="" disabled selected>Floor</option>
              <option value="1">Floor 0</option>
              <option value="2">Floor 1</option>
              <option value="3">Floor 2</option>
              <option value="4">Floor 3</option>
              <option value="5">Floor 4</option>
              <option value="6">Floor 5</option>
            </select>
          </div>

          <div style="flex: 1">
            <label>Bed</label>
            <select name="bed_no" required>
              <option value="1">Bed 1</option>
              <option value="2">Bed 2</option>
              <option value="3">Bed 3</option>
              <option value="4">Bed 4</option>
            </select>
          </div>
        </div>

        <label>Room Number</label>
        <select id="room" name="room_id" required>
          <option value="">Select Floor first</option>
        </select>

        <button type="submit">Create Account</button>
      </form>
    </div>

    <script>
      function updateRooms() {
        const floor = document.getElementById("floor").value;
        const roomSelect = document.getElementById("room");
        roomSelect.innerHTML = "";

        const floorNum = parseInt(floor);
        const base = (floorNum - 1) * 100;

        for (let i = 1; i <= 5; i++) {
          const roomNo = base + i;
          const option = document.createElement("option");
          option.value = roomNo;
          option.textContent = "Room " + roomNo;
          roomSelect.appendChild(option);
        }
      }
    </script>
  </body>
</html>
