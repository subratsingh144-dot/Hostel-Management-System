<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>HostelMS | Complaints</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family: "Segoe UI", sans-serif;
  background: #0f172a;
  color: #fff;
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* SIDEBAR */
.sidebar {
  width: 240px;
  background: #020617;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.menu-item {
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 10px;
  color: #94a3b8;
  text-decoration: none;
}

.menu-item.active {
  background: linear-gradient(90deg,#6366f1,#8b5cf6);
  color: #fff;
}

/* MAIN */
.main {
  flex:1;
  padding:40px;
  overflow-y:auto;
}

/* CARD */
.card {
  background: linear-gradient(135deg,#1e293b,#0f172a);
  padding:25px;
  border-radius:16px;
  margin-bottom:25px;
}

/* FORM */
input, select, textarea {
  width:100%;
  padding:12px;
  margin-top:8px;
  margin-bottom:20px;
  background:#020617;
  border:1px solid #334155;
  border-radius:8px;
  color:#fff;
}

textarea { height:120px; }

button {
  background: linear-gradient(90deg,#6366f1,#8b5cf6);
  border:none;
  padding:10px 20px;
  border-radius:8px;
  color:#fff;
  cursor:pointer;
}

/* TABLE */
table {
  width:100%;
  border-collapse:collapse;
}

th, td {
  padding:12px;
  text-align:left;
}

th {
  color:#94a3b8;
  border-bottom:1px solid #334155;
}

tr:not(:last-child){
  border-bottom:1px solid #334155;
}

/* STATUS */
.status {
  padding:5px 12px;
  border-radius:20px;
  font-size:12px;
}

.resolved {
  background:rgba(34,197,94,0.2);
  color:#22c55e;
}

.pending {
  background:rgba(234,179,8,0.2);
  color:#eab308;
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <h2 style="margin-bottom:20px;">🏠 HostelMS</h2>

  <a href="/user/userDashboard" class="menu-item">My Room</a>
  <a href="/user/payments" class="menu-item">Payments</a>
  <a href="/user/complaints" class="menu-item active">Complaints</a>
  <a href="/user/notices" class="menu-item">Notices</a>

  <div style="margin-top:auto;">
    <form action="/logout">
      <button style="width:100%; background:#ef4444;">Sign Out</button>
    </form>
  </div>
</div>

<!-- MAIN -->
<div class="main">

  <h2>Complaints</h2>
  <p style="color:#94a3b8; margin-bottom:20px;">
    Report and track your issues
  </p>

  <!-- FORM -->
  <div class="card">
    <h3 style="margin-bottom:15px;">📝 Raise a New Complaint</h3>

    <form action="/user/complaints" method="POST">
      <label>Category</label>
      <select name="category" required>
        <option value="water">Water supply issue</option>
        <option value="electricity">Electricity issue</option>
        <option value="wifi">WiFi issue</option>
        <option value="furniture">Furniture issue</option>
        <option value="cleaning">Cleaning issue</option>
        <option value="noise">Noise issue</option>
        <option value="other">Other</option>
      </select>

      <label>Description</label>
      <textarea name="description" placeholder="Describe your issue..." required></textarea>

      <button type="submit">Submit Complaint</button>
    </form>
  </div>

  <!-- LIST -->
   <div class="card">
    <table>
      <thead>
        <tr>
          <th>Category</th>
          <th>Description</th>
          <th>Date Of Create</th>
          <th>Date Of Update</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>
        <% complaints.forEach(c => { %>
          <tr>
            <td><%= c.category %></td>
            <td><%= c.description %></td>
            <td><%= new Date(c.created_at).toISOString().split('T')[0] %></td>
            <td><%= new Date(c.updated_at).toISOString().split('T')[0] %></td>
            <td>
              <span class="status <%= c.status === 'Resolved' ? 'resolved' : 'pending' %>">
                <%= c.status %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table> 
  </div>

</div>

</body>
</html>